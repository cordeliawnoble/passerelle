<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Passerelle</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --bg:#161513; --bg-2:#1E1C19; --card:#161513;
    --line:rgba(255,255,255,0.08);
    --text:#F3EFE6; --text-dim:#8A8780;
    --lavender:#8C7FB0; --accent:#C9A227;
  }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--bg); color:var(--text); font-family:'Lora',serif; min-height:100vh; }
  h1,h2{ font-family:'Cormorant Garamond',serif; font-weight:600; margin:0; }
  a{ color:inherit; }

  .topbar{ display:flex; align-items:center; justify-content:space-between; padding:16px 32px; border-bottom:1px solid var(--line); background:var(--bg-2); }
  .brand{ font-family:'Cormorant Garamond',serif; font-size:1.3rem; letter-spacing:0.03em; }
  .who{ font-size:13px; color:var(--text-dim); display:flex; align-items:center; gap:14px; }
  .who button{ background:none; border:1px solid var(--line); color:var(--text-dim); padding:6px 14px; border-radius:20px; cursor:pointer; font-family:'Lora',serif; font-size:12px; }

  .wrap{ max-width:900px; margin:0 auto; padding:40px 24px 80px; }

  /* ---- écran de connexion ---- */
  .auth-box{ max-width:380px; margin:80px auto; background:var(--bg-2); border:1px solid var(--line); border-radius:8px; padding:32px; }
  .auth-box h1{ font-size:1.6rem; margin-bottom:6px; text-align:center; }
  .auth-box .sub{ text-align:center; color:var(--text-dim); font-size:13px; margin-bottom:24px; }
  .auth-tabs{ display:flex; gap:4px; margin-bottom:20px; border:1px solid var(--line); border-radius:20px; padding:3px; }
  .auth-tabs button{ flex:1; background:none; border:none; color:var(--text-dim); padding:8px; border-radius:16px; cursor:pointer; font-family:'Lora',serif; font-size:13px; }
  .auth-tabs button.active{ background:var(--accent); color:var(--bg); font-weight:500; }
  label{ display:block; font-size:12px; color:var(--text-dim); margin:14px 0 5px; }
  input{ width:100%; background:var(--bg); border:1px solid var(--line); color:var(--text); border-radius:5px; padding:10px 12px; font-family:'Lora',serif; font-size:14px; }
  .auth-submit{ width:100%; margin-top:22px; background:var(--accent); color:var(--bg); border:none; padding:12px; border-radius:5px; font-weight:500; cursor:pointer; font-family:'Lora',serif; font-size:14px; }
  .auth-msg{ font-size:12px; margin-top:14px; text-align:center; min-height:16px; }
  .auth-msg.error{ color:#e88; }
  .auth-msg.ok{ color:#8fc95a; }

  /* ---- catalogue sagas ---- */
  .head-row{ display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; }
  .btn-primary{ background:var(--accent); color:var(--bg); border:none; padding:10px 18px; border-radius:5px; cursor:pointer; font-family:'Lora',serif; font-size:13px; font-weight:500; }
  .btn-secondary{ background:var(--bg-2); border:1px solid var(--line); color:var(--text); padding:10px 18px; border-radius:5px; cursor:pointer; font-family:'Lora',serif; font-size:13px; }

  .gallery{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  @media (max-width:700px){ .gallery{ grid-template-columns:1fr; } }
  .card{ position:relative; border:1px solid var(--line); border-radius:6px; overflow:hidden; background:var(--bg-2); cursor:pointer; transition:border-color .15s; }
  .card:hover{ border-color:var(--accent); }
  .card .top{ height:90px; display:flex; align-items:center; justify-content:center; font-family:'Cormorant Garamond',serif; font-size:1.5rem; }
  .card .body{ padding:12px 14px; }
  .card .nom{ font-size:15px; font-weight:500; margin-bottom:3px; }
  .card .meta{ font-size:12px; color:var(--text-dim); }
  .card .edit{ position:absolute; top:8px; right:8px; color:var(--text-dim); font-size:13px; z-index:2; }

  .empty{ text-align:center; padding:60px 20px; color:var(--text-dim); border:1px dashed var(--line); border-radius:6px; }

  /* ---- modal ---- */
  .modal-overlay{ position:fixed; inset:0; background:rgba(0,0,0,0.55); display:none; align-items:flex-start; justify-content:center; z-index:100; padding:40px 20px; overflow-y:auto; }
  .modal-overlay.open{ display:flex; }
  .modal-box{ background:var(--bg-2); border:1px solid var(--line); border-radius:6px; width:100%; max-width:520px; }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; padding:18px 24px; border-bottom:1px solid var(--line); }
  .modal-head button{ background:none; border:none; color:var(--text-dim); font-size:18px; cursor:pointer; }
  .modal-body{ padding:20px 24px; display:flex; flex-direction:column; gap:12px; max-height:65vh; overflow-y:auto; }
  .modal-foot{ display:flex; justify-content:flex-end; gap:10px; padding:16px 24px; border-top:1px solid var(--line); }
  .row2{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  textarea{ width:100%; background:var(--bg); border:1px solid var(--line); color:var(--text); border-radius:5px; padding:10px 12px; font-family:'Lora',serif; font-size:14px; min-height:70px; resize:vertical; }

  .status-line{ text-align:center; color:var(--text-dim); font-size:13px; padding:40px; }
</style>
</head>
<body>

<div id="app">
  <div class="status-line">Chargement…</div>
</div>

<script>
  const supabaseUrl = 'https://ilhfzulwuuxyidhityoo.supabase.co';
  const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlsaGZ6dWx3dXV4eWlkaGl0eW9vIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY4NDA5NTgsImV4cCI6MjEwMjQxNjk1OH0.nux1ehaes_1rPSQhaYJ3hdCcipYn3B5PQMokUzSuBl0';
  const sb = window.supabase.createClient(supabaseUrl, supabaseKey);
  const db = () => sb.schema('passerelle');  // toutes les tables Passerelle vivent dans ce schéma dédié

  const app = document.getElementById('app');

  // ---------- Démarrage : vérifie s'il y a déjà une session ----------
  async function init(){
    const { data: { session } } = await sb.auth.getSession();
    if (session) {
      renderCatalogue(session.user);
    } else {
      renderAuth();
    }
  }

  // ---------- Écran de connexion / inscription ----------
  function renderAuth(mode){
    mode = mode || 'login';
    app.innerHTML = `
      <div class="wrap">
        <div class="auth-box">
          <h1>Passerelle</h1>
          <div class="sub">L'atelier de vos histoires</div>
          <div class="auth-tabs">
            <button id="tab-login" class="${mode==='login'?'active':''}" onclick="renderAuth('login')">Se connecter</button>
            <button id="tab-signup" class="${mode==='signup'?'active':''}" onclick="renderAuth('signup')">Créer un compte</button>
          </div>
          <label>Email</label>
          <input type="email" id="auth-email" placeholder="toi@exemple.com">
          <label>Mot de passe</label>
          <input type="password" id="auth-password" placeholder="••••••••">
          <button class="auth-submit" onclick="${mode==='login' ? 'doLogin()' : 'doSignup()'}">${mode==='login' ? 'Se connecter' : 'Créer mon compte'}</button>
          <div class="auth-msg" id="auth-msg"></div>
        </div>
      </div>
    `;
  }

  async function doLogin(){
    const email = document.getElementById('auth-email').value.trim();
    const password = document.getElementById('auth-password').value;
    const msg = document.getElementById('auth-msg');
    msg.textContent = 'Connexion…'; msg.className = 'auth-msg';
    const { data, error } = await sb.auth.signInWithPassword({ email, password });
    if (error) { msg.textContent = error.message; msg.className = 'auth-msg error'; return; }
    renderCatalogue(data.user);
  }

  async function doSignup(){
    const email = document.getElementById('auth-email').value.trim();
    const password = document.getElementById('auth-password').value;
    const msg = document.getElementById('auth-msg');
    if (password.length < 6) { msg.textContent = 'Le mot de passe doit faire au moins 6 caractères.'; msg.className = 'auth-msg error'; return; }
    msg.textContent = 'Création du compte…'; msg.className = 'auth-msg';
    const { data, error } = await sb.auth.signUp({ email, password });
    if (error) { msg.textContent = error.message; msg.className = 'auth-msg error'; return; }
    if (data.session) {
      renderCatalogue(data.user);
    } else {
      msg.textContent = 'Compte créé — vérifie ta boîte mail pour confirmer, puis connecte-toi.';
      msg.className = 'auth-msg ok';
    }
  }

  async function doLogout(){
    await sb.auth.signOut();
    renderAuth();
  }

  // ---------- Catalogue des sagas (vraies données Supabase) ----------
  let currentUser = null;

  async function renderCatalogue(user){
    currentUser = user;
    app.innerHTML = `
      <div class="topbar">
        <div class="brand">✒️ Passerelle</div>
        <div class="who">${user.email} <button onclick="doLogout()">Déconnexion</button></div>
      </div>
      <div class="wrap">
        <div class="head-row">
          <div><h2>Sagas</h2></div>
          <button class="btn-primary" onclick="openSagaModal()">+ Créer une saga</button>
        </div>
        <div id="sagas-zone"><div class="status-line">Chargement de tes sagas…</div></div>
      </div>
      ${modalHtml()}
    `;
    await loadSagas();
  }

  async function loadSagas(){
    const zone = document.getElementById('sagas-zone');
    const { data, error } = await db().from('sagas').select('id, nom, genre, statut, archive').order('ordre', { ascending: true });
    if (error) {
      zone.innerHTML = `<div class="empty">Erreur de chargement : ${error.message}<br><span style="font-size:11px;">Vérifie que le schéma "passerelle" est bien ajouté dans Exposed schemas (Supabase → Settings → API).</span></div>`;
      return;
    }
    if (!data.length) {
      zone.innerHTML = `<div class="empty">Aucune saga pour l'instant.<br><br><button class="btn-primary" onclick="openSagaModal()">Créer ta première saga</button></div>`;
      return;
    }
    zone.innerHTML = `<div class="gallery">${data.map(s => `
      <div class="card" onclick="openSagaModal('${s.id}')">
        <div class="top" style="background:linear-gradient(160deg, var(--lavender)33, var(--bg-2));">${(s.nom||'').split(' ').map(w=>w[0]).join('').slice(0,3)}</div>
        <div class="body">
          <div class="nom">${s.nom}</div>
          <div class="meta">${s.genre || '—'} · ${s.statut || 'Sans statut'}${s.archive ? ' · Archivée' : ''}</div>
        </div>
      </div>
    `).join('')}</div>`;
  }

  // ---------- Modal création / édition ----------
  function modalHtml(){
    return `
      <div class="modal-overlay" id="modal-overlay" onclick="if(event.target===this) closeSagaModal()">
        <div class="modal-box">
          <div class="modal-head">
            <h2 id="modal-title" style="font-size:1.3rem;">Nouvelle saga</h2>
            <button onclick="closeSagaModal()">✕</button>
          </div>
          <div class="modal-body">
            <div><label>Nom de la saga</label><input id="f-nom"></div>
            <div class="row2">
              <div><label>Genre</label><input id="f-genre"></div>
              <div><label>Statut</label>
                <select id="f-statut" style="width:100%; background:var(--bg); border:1px solid var(--line); color:var(--text); border-radius:5px; padding:10px 12px; font-family:'Lora',serif; font-size:14px;">
                  <option>Saga en cours</option><option>En pause</option><option>Terminée</option>
                </select>
              </div>
            </div>
            <div><label>Résumé / à propos</label><textarea id="f-description"></textarea></div>
          </div>
          <div class="modal-foot">
            <button class="btn-secondary" onclick="closeSagaModal()">Annuler</button>
            <button class="btn-primary" onclick="saveSaga()">Enregistrer</button>
          </div>
        </div>
      </div>
    `;
  }

  let editingSagaId = null;

  async function openSagaModal(id){
    editingSagaId = id || null;
    document.getElementById('modal-title').textContent = id ? 'Modifier la saga' : 'Nouvelle saga';
    document.getElementById('f-nom').value = '';
    document.getElementById('f-genre').value = '';
    document.getElementById('f-statut').value = 'Saga en cours';
    document.getElementById('f-description').value = '';
    if (id) {
      const { data, error } = await db().from('sagas').select('nom, genre, statut, description').eq('id', id).single();
      if (!error && data) {
        document.getElementById('f-nom').value = data.nom || '';
        document.getElementById('f-genre').value = data.genre || '';
        document.getElementById('f-statut').value = data.statut || 'Saga en cours';
        document.getElementById('f-description').value = data.description || '';
      }
    }
    document.getElementById('modal-overlay').classList.add('open');
  }

  function closeSagaModal(){
    document.getElementById('modal-overlay').classList.remove('open');
  }

  async function saveSaga(){
    const payload = {
      nom: document.getElementById('f-nom').value.trim() || 'Sans titre',
      genre: document.getElementById('f-genre').value.trim(),
      statut: document.getElementById('f-statut').value,
      description: document.getElementById('f-description').value.trim(),
    };
    let error;
    if (editingSagaId) {
      ({ error } = await db().from('sagas').update(payload).eq('id', editingSagaId));
    } else {
      payload.user_id = currentUser.id;
      ({ error } = await db().from('sagas').insert(payload));
    }
    if (error) { alert('Erreur : ' + error.message); return; }
    closeSagaModal();
    await loadSagas();
  }

  init();
</script>
</body>
</html>
